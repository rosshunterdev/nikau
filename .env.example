# AI Matching settings. Copy to .env in the repo root (nikau/) and fill in.
# AI Matching loads this file from app/main.py. The Core API has its own: services/core-api/.env.example
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Gemini key from Google AI Studio. Never commit it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Must be the same value as MATCHING_SERVICE_KEY in services/core-api/.env
# Make one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MATCHING_SERVICE_KEY=
