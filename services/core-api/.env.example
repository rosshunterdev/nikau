# Core API settings. Copy to .env in this folder (services/core-api/) and fill in.
# Local Supabase values: run `supabase status -o env` from the repo root.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=

# Must be a JSON list (quotes and square brackets). Vite uses 5174 when 5173 is busy.
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174"]

# AI Matching service. The key must be the same value as MATCHING_SERVICE_KEY in the root .env.
AI_MATCHING_URL=http://127.0.0.1:8001
MATCHING_SERVICE_KEY=
